# SMARTERPICKS — environment variables
# Copy to .env.local (gitignored) for local dev. In production, set
# these in Vercel: Project → Settings → Environment Variables.
# =============================================================

# -------------------------------------------------------------
# Server-side secrets (USED BY /api/* serverless functions)
# These never reach the browser.
# -------------------------------------------------------------

# Anthropic API key — powers /api/claude-chat (AI Pick Explainer)
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxx

# (Future use) If you ever add a server-side Whop access proxy,
# set a company-level API key here. NEVER paste secrets in chat.
WHOP_API_KEY=apik_xxxxxxxxxx


# -------------------------------------------------------------
# Public configuration (NEXT_PUBLIC_* convention)
#
# NOTE: This is a static HTML site, not a Next.js project — there
# is no build step that substitutes these into the HTML. They're
# documented here for two reasons:
#   1. Future migration to a build pipeline that DOES substitute.
#   2. So you know which URLs need to stay in sync across files.
#
# Today, these values live as hardcoded constants in:
#   - index.html  (pricing card hrefs, hero CTA, nav, drawer, etc.)
#   - login.html  (CONFIG.CHECKOUT_URL_MONTHLY / _ANNUAL)
#   - discord.html (premium tier CTA)
# If you change the URLs below, also update them in those files.
# -------------------------------------------------------------

# Whop checkout link for the monthly plan — must be trial-enabled
NEXT_PUBLIC_WHOP_MONTHLY_URL=https://whop.com/checkout/plan_VIlKaPMvfDPoj?trial=7

# Whop checkout link for the yearly plan — must be trial-enabled
NEXT_PUBLIC_WHOP_YEARLY_URL=https://whop.com/checkout/plan_UvETXgAfoUQj5?trial=7
